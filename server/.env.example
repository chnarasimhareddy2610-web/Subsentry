# Copy to .env and fill in with your own values. Never commit the real file.
PORT=5000
NODE_ENV=development

# MongoDB connection string. MONGODB_URI is the primary variable; MONGO_URI is
# accepted as a legacy alias but never overrides it.
#
# MongoDB Atlas (recommended): use the SRV string from Atlas → Connect. If the
# password contains characters such as @ : / or ?, percent-encode them
# (e.g. p@ss → p%40ss). When the URI uses mongodb+srv://, the dev orchestrator
# skips the local mongod entirely and connects straight to Atlas.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/subsentry?retryWrites=true&w=majority
#
# Optional local development mode: comment out the Atlas URI above and use the
# on-disk database in .data/mongodb (started automatically by `npm run dev`).
# MONGODB_URI=mongodb://127.0.0.1:27017/subsentry

# Allowed browser origin for the API (Vite dev server by default). When the
# Express process also serves the built SPA, requests are same-origin and do not
# need CORS; set this to your deployed origin if the API is called cross-origin.
CLIENT_ORIGIN=http://localhost:5173

# A subscription is considered low usage when its recorded usage is below this value
LOW_USAGE_THRESHOLD=3

# Number of days ahead that counts as an "upcoming renewal"
RENEWAL_WINDOW_DAYS=7

# ---------------------------------------------------------------------------
# Access control — set these before exposing the app on the internet
# ---------------------------------------------------------------------------
# SubSentry has no user accounts: it is a single-operator ledger. When both
# values are set, every page and every API route requires these HTTP Basic
# credentials; only /api/health stays open for platform health checks.
# Leave them blank for local development. Always use HTTPS when they are set.
# AUTH_USER=
# AUTH_PASSWORD=

# Set to 1 when the app runs behind a reverse proxy or platform load balancer,
# so rate limiting (and logging) sees the real client IP address.
# TRUST_PROXY=1

# Data-changing requests allowed per IP per window. Reads are never throttled.
# Set WRITE_RATE_LIMIT_MAX=0 to disable the limiter (e.g. behind an edge WAF).
# WRITE_RATE_LIMIT_MAX=120
# WRITE_RATE_LIMIT_WINDOW_MS=300000
